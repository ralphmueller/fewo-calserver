# ── Umgebung ────────────────────────────────────────────────────────────────
# Erlaubte Werte: development | staging | production
ENV=development

# ── Datenbank ────────────────────────────────────────────────────────────────
DEVELOPMENT_DATABASE=mysql+pymysql://user:password@localhost/fewo_dev
PRODUCTION_DATABASE=mysql+pymysql://user:password@localhost/fewo

# ── Flask ────────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-string

# ── E-Mail (SMTP) ────────────────────────────────────────────────────────────
EMAIL_ADDRESS=noreply@example.com
EMAIL_USER=noreply@example.com
EMAIL_PASSWORD=your-smtp-password
EMAIL_HOST=smtp.example.com

# Empfänger für Team-Benachrichtigungen (kommagetrennt)
EMAILS_TEAM=owner@example.com
INFO_EMAIL=info@example.com

# ── Betreiber-Stammdaten (erscheinen in Rechnungen und E-Mails) ───────────────
OPERATOR_NAME=Meine Ferienwohnungen
OPERATOR_INHABER=Max Mustermann
OPERATOR_STRASSE=Musterstraße 1
OPERATOR_PLZ_ORT=12345 Musterstadt
OPERATOR_GEMEINDE=Musterstadt
OPERATOR_TEL=+49 123 456789
OPERATOR_TEL_INTL=
OPERATOR_EMAIL=info@example.com
OPERATOR_WEBSITE=https://www.example.com
OPERATOR_IBAN=DE00 0000 0000 0000 0000 00
OPERATOR_BIC=XXXXXXXX
OPERATOR_UST_ID=DE 000 000 000
OPERATOR_PAYPAL=paypal@example.com
OPERATOR_SCHLUESSEL=Herr/Frau Mustermann, Musterstraße 1
OPERATOR_WLAN_SSID=Meine-Ferienwohnung-Gast
OPERATOR_KURTAXE_LINK=

# ── Kurtaxe / Steuern ────────────────────────────────────────────────────────
KURTAXE_SATZ_VZ=2.1
KURTAXE_SATZ_HZ=0.5
MWST_SATZ=7

# Stornobedingungen
OPERATOR_STORNO_FRIST=7
OPERATOR_STORNO_GEBUEHR=50

# ── Feratel Deskline (Gästemeldung) ──────────────────────────────────────────
# FERATEL_MOCK=true  → kein echter Browser, nur Logging (für Entwicklung)
FERATEL_MOCK=true
FERATEL_ID=your-feratel-username
FERATEL_PW=your-feratel-password
FERATEL_ACCOMMODATION_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# JSON-Mapping Apartment-Code → Feratel-Einheitenname
# Beispiel: {"F1": "Meine Wohnung 1", "G1": "Meine Wohnung 2"}
FERATEL_APARTMENT_MAP={}

# ── Staging-Server ───────────────────────────────────────────────────────────
# Nur für ENV=staging erforderlich
# SERVER_NAME=meinserver.example.com:8080
